# 컨테이너에 담지 않는 것
#
# 소스와 configs 만 담는다. 데이터와 로그는 볼륨으로 붙이고, .git 은 넣지 않는다.
# 버전 정보는 빌드 인자로 받는다.

# 파이썬 산출물
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/

# 가상환경
.venv/
venv/
env/

# 버전 관리
.git/
.gitignore
.gitattributes

# 데이터와 로그. 볼륨으로 붙인다
data/
logs/
volumes/

# 검사 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 개발 전용
tests/
scripts/
docs/
.kiro/
*.md
.env
.env.*
!.env.example

# 백업과 산출물
*.tar.gz
*.zip
*.bak
*_backup.*
world_map*.html
